# Étape 1 : Build du frontend
FROM node:20-alpine as build

WORKDIR /app
COPY package*.json ./
RUN npm ci --silent
COPY . .
RUN npm run build

# Étape 2 : Serveur Nginx pour héberger le build
FROM nginx:alpine

# Copie le build dans le dossier par défaut de Nginx
COPY --from=build /app/dist /usr/share/nginx/html

# Copie la config nginx personnalisée si tu veux gérer le /api/
# (facultatif, sinon Nginx servira juste le frontend statique)
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
